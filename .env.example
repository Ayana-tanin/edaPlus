# Токен от @BotFather. Без него бот выключен, а уведомления пишутся в лог.
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App (Telegram не откроет http).
WEBAPP_URL=https://example.com

# Только для docker compose на сервере: домен без https://, для него Caddy получит сертификат.
# Должен совпадать с адресом в WEBAPP_URL.
DOMAIN=example.com

# Telegram ID администраторов через запятую. Свой ID покажет бот по команде /id.
ADMIN_TELEGRAM_IDS=

APP_TIMEZONE=Asia/Bishkek
CURRENCY=сом
DEFAULT_CITY=Бишкек

# За сколько минут до начала получения напоминать покупателю.
REMINDER_MINUTES=30
# Сколько минут после конца получения заказ ещё считается активным.
NO_SHOW_GRACE_MINUTES=30

API_PORT=3000

# Только для разработки: вход без Telegram и переключатель ролей в профиле.
# При NODE_ENV=production игнорируется.
DEV_AUTH=false
